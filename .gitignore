__pycache__/
*.pyc
.venv/
dist/
*.egg-info

# Tokenizer vocabulary — large binary files
tokenizer/*.model
tokenizer/*.vocab
tokenizer-data/

# Corpus data — large, local only
*.jsonl
data/*
# models/ stays ignored, but provenance records (story 131.24) are tracked.
**/models/**
!**/models/**/
!**/models/**/*.provenance.json
!**/models/**/provenance.json

.env
.DS_Store
.vscode/

# Story 131.20 baseline artefacts: the sample ids MUST be tracked so 131.21 measures the same records.
!data/baseline_sample_ids_v04.txt
!data/baseline_v04_*.json
!data/baseline_v04_*_per_record.csv

# Story 131.23 must-merge list: the data file AND the seeded corpus sample it was derived from
# are tracked so tests/test_derive_must_merge.py can re-derive it hermetically (byte-identical).
!data/must_merge_v04.json
!data/must_merge_sample_v04.txt
